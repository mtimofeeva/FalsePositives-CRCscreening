clear
* working directory
cd "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\data\FPR"

* Create Word document
putdocx clear
putdocx begin
putdocx paragraph, style(Heading1)
putdocx text ("Sensitivity analyses of relative risks of false positive rates")
putdocx paragraph, style(Heading2)
putdocx text ("FIT")


*** Age (50-59 vs. 60-69) ******************************************************
use "fpr_fit_50-59vs60-69.dta", clear
drop if strpos(rob, "High") > 0

    * Meta-analysis HKSJ
meta set log_RR_FPR_comp_ref se, studylabel(author_year) eslabel(log_RR)
    
meta summarize, se(khartung) nostudies
scalar p_hksj = r(p)
display %9.2e p_hksj
meta forestplot, se(khartung) eform nullrefline esrefline cibind(parentheses)
gr export "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Forest_plot_FIT_FPR_age50-59vs60-69_HKSJ_sens.png", replace

putdocx paragraph, style(Heading2)
putdocx text ("Age (50-59 vs. 60-69)")
putdocx paragraph, style(Heading3)
putdocx text ("excluding studies at high risk of bias")
putdocx paragraph
putdocx image "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Forest_plot_FIT_FPR_age50-59vs60-69_HKSJ_sens.png", width(8cm)

    * Meta-analysis REML due to only two studies not at high risk of bias
meta set log_RR_FPR_comp_ref se, studylabel(author_year) eslabel(log_RR)
    
meta summarize
scalar p_reml = r(p)
display %9.2e p_reml
meta forestplot, eform nullrefline esrefline cibind(parentheses)
gr export "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Forest_plot_FIT_FPR_age50-59vs60-69_sens.png", replace
putdocx image "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Forest_plot_FIT_FPR_age50-59vs60-69_sens.png", width(8cm)

