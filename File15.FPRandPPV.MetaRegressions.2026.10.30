** excluding studies with missing information in any of the test characteristics
tab type // NR = 0
tab cutoff // NR = 0
tab def_true_positive // NR = 0
tab population // NR = 0
// no missing information for test characteristics - sensitivity analysis not performed

*****************
* performing stratified analyses
* check for number of studies in each strata
