keep if strpos(type, "OC-Sensor") >0
meta set log_RR_PPV_comp_ref se, studylabel(author_year) eslabel(log_RR)
meta regress agecovariate, se(khartung) eform

* put data to Excel
putexcel set "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Regressions.xlsx", sheet("PPV_stra2") modify
do "$dofolder\Rtable.do"
do "$dofolder\ExcelReg.do"
putexcel A1 = "Meta regression of relative risks of positive predictive values with age in 5-year intervals as covariate. Stratified analysis of studies using the test type OC-Sensor"

