clear
* working directory
cd "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\data\PPV"

* Create Word document
putdocx clear
putdocx begin
putdocx paragraph, style(Heading1)
putdocx text ("Sensitivity analyses of relative risks of positive predictive values")


*** Sex FIT ********************************************************************
use "ppv_fit_sex.dta", clear
drop if strpos(rob, "High") > 0

    * Meta-analysis HKSJ
meta set log_RR_PPV_comp_ref se, studylabel(author_year) eslabel(log_RR)
    
meta summarize, se(khartung) nostudies
scalar p_hksj = r(p)
display %9.2e p_hksj
meta forestplot, se(khartung) eform nullrefline esrefline cibind(parentheses)
gr export "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Forest_plot_FIT_PPV_sex_HKSJ_sens.png", replace

putdocx paragraph, style(Heading2)
putdocx text ("Sex")
putdocx paragraph, style(Heading3)
putdocx text ("excluding studies at high risk of bias")
putdocx paragraph, style(Heading3)
putdocx text ("FIT")
putdocx paragraph
putdocx image "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output\Forest_plot_FIT_PPV_sex_HKSJ_sens.png", width(8cm)

