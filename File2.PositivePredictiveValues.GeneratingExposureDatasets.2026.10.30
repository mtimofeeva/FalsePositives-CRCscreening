********************************************
*** descriptives on PPV data
********************************************
table gfobt_fit
table exp_ref_comp if gfobt_fit=="FIT"
table exp_ref_comp if gfobt_fit=="gFOBT"
table exp_ref_comp if gfobt_fit=="gFOBT and FIT"
