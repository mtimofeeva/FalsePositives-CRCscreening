drop if study_number==62 & strpos(screening_round, "incident") > 0 //dropping round with smallest population of study with redundant popultions
drop if study_number==131 & strpos(def_true_positive, "cancer") > 0 //dropping one definition of study with several definitions available, leaving the definition of AN
drop if study_number==131 & strpos(screening_round, "incident") > 0 //dropping round with smallest population of study with redundant popultions
replace author_year = "Chen, 2018, males" if (strpos(exp_ref_comp, "Age in males (50-59 vs. 60-69)"))>0
replace author_year = "Chen, 2018, females" if (strpos(exp_ref_comp, "Age in females (50-59 vs. 60-69)"))>0
