save "ppv_fit_age50-59vs60-69", replace
restore

* Age (40-49 vs. 50-59)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Age"))
keep if (strpos(exp_ref_comp, "(40-49 vs. 50-59"))
replace author_year = "Chang, 2014, males" if (strpos(exp_ref_comp, "Age at screening in men (40-49 vs. 50-59)"))>0
