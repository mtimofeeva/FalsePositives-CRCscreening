save "ppv_fit_age56-59vs60-64", replace
restore

* Age (56-59 vs. 65-69)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Age"))
keep if (strpos(exp_ref_comp, "Age (56–59 vs. 65-69)")) | (strpos(exp_ref_comp, "Age (56-59 vs. 65-69)"))
replace rf = "Age (56-59 vs. 65-69)"
save "ppv_fit_age56-59vs65-69", replace
restore

* Age (56-59 vs. 70-74)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Age"))
keep if (strpos(exp_ref_comp, "Age (56–59 vs. 70-74)")) | (strpos(exp_ref_comp, "Age (56-59 vs. 70-74)"))
replace rf = "Age (56-59 vs. 70-74)"
save "ppv_fit_age56-59vs70-74", replace
restore

* Aspirin (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Aspirin")) | (strpos(exp_ref_comp, "Acetylsalicylic"))
drop if (strpos(exp_ref_comp, "Aspirin +")) > 0
drop if (strpos(exp_ref_comp, "Antithromb")) > 0
gsort study_number screening_round -total_part //sorting by study number screening round and then total participants in descending order
by study_number: gen tag = _n == 1
keep if tag==1
replace rf = "Aspirin"
save "ppv_fit_aspirin", replace
restore

* NSAIDs (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "NSAID"))
drop if (strpos(exp_ref_comp, "Any")) > 0
replace rf = "NSAIDs"
save "ppv_fit_NSAIDs", replace
restore

* Antiplatelet agent (no vs. yes) (including all specified types, including Aspirin, NSAIDs, Clopidogrel, Cilostazol, and dual and triple therapies)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Aspirin")) | (strpos(exp_ref_comp, "Acetylsalicylic")) | (strpos(exp_ref_comp, "NSAID")) | (strpos(exp_ref_comp, "Cilostazol")) | (strpos(exp_ref_comp, "Thieno")) | (strpos(exp_ref_comp, "Dual")) | (strpos(exp_ref_comp, "Clopidogrel")) | (strpos(exp_ref_comp, "Antiplatelet")) | (strpos(exp_ref_comp, "Dipyridamole"))
drop if (strpos(exp_ref_comp, "Antithromb")) > 0 | (strpos(exp_ref_comp, "anticoa")) > 0
gsort study_number -total_part //sorting by study number screening round and then total participants in descending order
drop if study_number==30 & strpos(exp_ref_comp, "Dipyridamole") >0 | study_number==30 & strpos(exp_ref_comp, "NSAIDs") >0 //keeping the row with the antiplatelet level among several rows of data from the same study where the totalt number of participants is identical
drop if study_number==65 & strpos(exp_ref_comp, "NSAIDs") >0 //keeping the row with the antiplatelet level among several rows of data from the same study where the totalt number of participants is identical
drop if study_number==145 & strpos(exp_ref_comp, "NSAIDs") >0 | study_number==145 & strpos(exp_ref_comp, "Aspirin") >0 //keeping the row with the antiplatelet level among several rows of data from the same study where the totalt number of participants is identical
by study_number: gen tag = _n == 1 
keep if tag==1 //dual and triple therapies automatically dropped since other lines from the studies contributed with larger populations
replace rf = "Antiplatelet agent"
save "ppv_fit_antiplatelet", replace
restore

* Oral anticoagulants (warfarin, direct-acting oral anticoagulants, and oral anticoagulants (unspecified)) (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Warfarin")) | (strpos(exp_ref_comp, "DOACs")) | (strpos(exp_ref_comp, "Oral anticoagulant")) | (strpos(exp_ref_comp, "Vitamin K")) | (strpos(exp_ref_comp, "Nonvitamin")) | (strpos(exp_ref_comp, "Anticoagulant"))
drop if (strpos(exp_ref_comp, "+"))
gsort study_number -total_part //sorting by study number screening round and then total participants in descending order
by study_number: gen tag = _n == 1
keep if tag==1
replace rf = "Oral anticoagulant"
save "ppv_fit_oac", replace
restore

* Antithrombotic agent (all antiplatelets and all anticoagulants) (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Aspirin")) | (strpos(exp_ref_comp, "Acetylsalicylic")) | (strpos(exp_ref_comp, "NSAID")) | (strpos(exp_ref_comp, "Cilostazol")) | (strpos(exp_ref_comp, "Thieno")) | (strpos(exp_ref_comp, "Dual")) | (strpos(exp_ref_comp, "Clopidogrel")) | (strpos(exp_ref_comp, "Antiplatelet")) | (strpos(exp_ref_comp, "Dipyridamole")) | (strpos(exp_ref_comp, "Warfarin")) | (strpos(exp_ref_comp, "DOACs")) | (strpos(exp_ref_comp, "Oral anticoagulant")) | (strpos(exp_ref_comp, "Vitamin K")) | (strpos(exp_ref_comp, "Nonvitamin")) | (strpos(exp_ref_comp, "Anticoagulant")) | (strpos(exp_ref_comp, "Antithrombitic")) | (strpos(exp_ref_comp, "Antithrombotic")) | (strpos(exp_ref_comp, "Antitrombitic")) | (strpos(exp_ref_comp, "Triple"))
drop if strpos(exp_ref_comp, "Any study drug") >0
gsort study_number -total_part //sorting by study number screening round and then total participants in descending order
drop if study_number==30 & strpos(exp_ref_comp, "Dipyridamole") >0 | study_number==30 & strpos(exp_ref_comp, "NSAIDs") >0 | strpos(exp_ref_comp, "Antiplatelet") >0 //keeping the row with the anticoagulant level among several rows of data from the same study where the totalt number of participants is identical
drop if study_number==65 & strpos(exp_ref_comp, "NSAIDs") >0 | strpos(exp_ref_comp, "Antiplatelet") >0 //keeping the row with the anticoagulant level among several rows of data from the same study where the totalt number of participants is identical
drop if study_number==87 & strpos(exp_ref_comp, "NSAIDs") >0 | strpos(exp_ref_comp, "Acetyl") >0 //keeping the row with the anticoagulant level among several rows of data from the same study where the totalt number of participants is identical
drop if study_number==145 & strpos(exp_ref_comp, "NSAIDs") >0 | study_number==145 & strpos(exp_ref_comp, "Aspirin") >0 | strpos(exp_ref_comp, "Antiplatelet") >0 //keeping the row with the anticoagulant level among several rows of data from the same study where the totalt number of participants is identical
by study_number: gen tag = _n == 1
keep if tag==1
replace rf = "Antithrombotic agent"
save "ppv_fit_antithrombotic", replace
restore

* Proton pump inhibitors (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Proton"))
drop if study_number==41 & strpos(cutoff, "80") >0 //dropping cutoffs that are furthers away from cutoffs applied by the studies to be compared with
drop if study_number==41 & strpos(cutoff, "100") >0
drop if study_number==41 & strpos(cutoff, "120") >0
drop if study_number==65 & strpos(exp_ref_comp, "combined") >0 //dropping the exposure where PPIs have been used in combination with other drugs to keep the most comparable exposure
replace rf = "Proton pump inhibitors"
save "ppv_fit_ppi", replace
restore

* Selective serotonin reuptake inhibitors (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "SSRI"))
drop if study_number==41 & strpos(cutoff, "80") >0 //dropping cutoffs that are furthers away from cutoffs applied by the studies to be compared with
drop if strpos(exp_ref_comp, "Any") >0
replace rf = "Selective serotonin reuptake inhibitors"
save "ppv_fit_ssri", replace
restore

