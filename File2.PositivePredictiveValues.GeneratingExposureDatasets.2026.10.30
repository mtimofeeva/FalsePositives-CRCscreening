keep if (strpos(exp_ref_comp, "(55-59 vs. 70-74)"))
replace author_year = "Brenner, 2014, males" if (strpos(exp_ref_comp, "Age at colonoscopy in men (55-59 vs. 70-74)"))>0
replace author_year = "Brenner, 2014, females" if (strpos(exp_ref_comp, "Age at colonoscopy in women (55-59 vs. 70-74)"))>0
replace rf = "Age (55-59 vs. 70-74)"
save "ppv_gfobt_age55-59vs70-74", replace
restore

* Aspirin (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "gFOBT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Aspirin")) //keeping only rows comparing aspirin. One study compared low-dose aspirin and higher dose aspirin or other NSAIDS, respectively, with the same control group. I kept the one with most participants, which was low-dose aspirin.
replace rf = "Aspirin"
save "ppv_gfobt_aspirin", replace
restore

* Warfarin (no vs. yes) (including one study that had both Warfarin and Aspirin in their usage group)
preserve
keep if (strpos(gfobt_fit, "gFOBT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Warfarin"))  //keeping only rows comparing warfarin
replace rf = "Warfarin"
save "ppv_gfobt_warfarin", replace
restore

* Antithrombotic (all antiplatelet and all anticoagulant) (no vs. yes)
preserve
keep if (strpos(gfobt_fit, "gFOBT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Aspirin")) | (strpos(exp_ref_comp, "Warfarin")) | (strpos(exp_ref_comp, "Anticoagulant"))
drop if study_number==49 & (strpos(exp_ref_comp, "Warfarin")) //dropping the study with repete control groups keeping the one with the largest population
replace rf = "Antithrombotic agent"
save "ppv_gfobt_antithrombotic", replace
restore

***********************************
* Continuing with exposures available from studies using only FIT
***********************************
* Sex (female vs. male)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Sex"))
//inspecting if there is redundant information from the same study population
drop if study_number==96 & (strpos(cutoff, "10")) //dropping repeat populations from the same study while keeping data from the most common cutoff
drop if study_number==96 & (strpos(cutoff, "15")) //dropping repeat populations from the same study while keeping data from the most common cutoff
drop if study_number==96 & (strpos(cutoff, "25")) //dropping repeat populations from the same study while keeping data from the most common cutoff
drop if study_number==96 & (strpos(cutoff, "30")) //dropping repeat populations from the same study while keeping data from the most common cutoff
drop if study_number==96 & (strpos(cutoff, "35")) //dropping repeat populations from the same study while keeping data from the most common cutoff
drop if study_number==96 & (strpos(cutoff, "40")) //dropping repeat populations from the same study while keeping data from the most common cutoff
drop if study_number==133 & (strpos(def_true_positive, "cancer")) //dropping repeat populations from the same study while keeping data from definition of true positive as advanced neoplasms
drop if study_number==121 & (strpos(def_true_positive, "cancer")) | (strpos(def_true_positive, "all")) //dropping repeat populations from the same study while keeping data from definition of true positive as advanced neoplasms
drop if study_number==131 & (strpos(def_true_positive, "cancer")) | (strpos(def_true_positive, "all")) //dropping repeat populations from the same study while keeping data from definition of true positive as advanced neoplasms
drop if study_number==131 & (strpos(screening_round, "incident")) //dropping repeat populations from the same study while keeping data from the screening round with the largest population
drop if study_number==120 & (strpos(exp_ref_comp, "second")) //dropping repeat populations from the same study while keeping data from the screening round with the largest population
drop if study_number==120 & (strpos(exp_ref_comp, "third")) //dropping repeat populations from the same study while keeping data from the screening round with the largest population
gsort study_number -total_part //sorting by study number and then total participants in descending order
by study_number: gen tag=_n==1
replace tag=1 if study_number==131 //assigning a tag "1" to the study dividing sex into age groups to not loose data
keep if tag==1 //keeping the observation with the most participants
replace author_year = "Tourne-Garcia, 2022, female 60-69 vs. male 60-69" if (strpos(exp_ref_comp, "Sex (female 60-69 vs. male 60-69)"))>0
replace author_year = "Tourne-Garcia, 2022, female 50-59 vs. male 50-59" if (strpos(exp_ref_comp, "Sex (female 50-59 vs. male 50-59)"))>0
replace rf = "Sex"
save "ppv_fit_sex", replace
restore

* Age (50-54 vs. 55-59) (two studies grouping 50-55 vs. 56-60)
preserve
keep if (strpos(gfobt_fit, "FIT"))
drop if (strpos(gfobt_fit, "gFOBT and FIT"))
codebook gfobt_fit //ensure that only data from gFOBT only is left
keep if (strpos(exp_ref_comp, "Age"))
keep if (strpos(exp_ref_comp, "(50-54 vs. 55-59")) | (strpos(exp_ref_comp, "(50-55 vs. 56-60)"))
drop if study_number==133 & strpos(def_true_positive, "cancer") >0 //dropping redundant populations keeping only data from definition of true positive as "advanced neoplasms"
replace author_year = "Digby, 2023, males" if (strpos(exp_ref_comp, "Age in men (50-54 vs. 55-59"))>0
replace author_year = "Digby, 2023, females" if (strpos(exp_ref_comp, "Age in women (50-54 vs. 55-59"))>0
replace author_year = "Njor, 2022, males" if (strpos(exp_ref_comp, "Age at screening in men (50-54 vs. 55-59)"))>0
replace author_year = "Njor, 2022, females" if (strpos(exp_ref_comp, "Age at screening in women (50-54 vs. 55-59)"))>0
replace rf = "Age (50-54 vs. 55-59)"
save "ppv_fit_age50-54vs55-59", replace
restore

