**********************************
** Absolute risk calculations ****
**********************************
clear

cd "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\output"

*******************
**FPR
*******************

* Create excel sheet for analysis results
putexcel set "Absoluterisks.xlsx", sheet("FPR") modify

putexcel A4 = ("Risk factor") B4 = ("Faecal test") C3 = ("Prevalence") ///
         C3 = ("Prevalence") C4 = ("Without risk factor") D4 = ("Lower 95% CI") ///
		 E4 = ("Upper 95% CI") F4 = ("With risk factor") G4 = ("Lower 95% CI") ///
		 H4 = ("Upper 95% CI") I3 = ("Overall risk") J4 = ("Lower 95% CI") ///
		 K4 = ("Upper 95% CI") L3 = ("Absolute risk")  ///
		 L4 = ("Without risk factor") M4 = ("Lower 95% CI") N4 = ("Upper 95% CI") ///
		 O4 = ("With risk factor") P4 = ("Lower 95% CI") Q4 = ("Upper 95% CI") ///
		 R3 = ("Absolute difference") S4 = ("Lower 95% CI") T4 = ("Upper 95% CI")

**********
**Age
**********
use "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\data\FPR\fpr_fit_50-54vs65-69.dta", clear

global dofolder "C:\Users\wpoulsen\OneDrive - Syddansk Universitet\PhD\SR MA false screening results\Statawork\FP outcomes\do"
do "${dofolder}\MagicforFPRabsoluterisks.do"

*export to Excel
local row = 5
putexcel A`row' = (rf) B`row' = (gfobt_fit) F`row' = (prev_rf) G`row' = (prev_rf_lb) H`row' = (prev_rf_ub) ///
		C`row' = (prev_ref) D`row' = (prev_ref_lb) E`row' = (prev_ref_ub) ///
		I`row' = (overallrisk) J`row' = (overallrisk_lb) K`row' = (overallrisk_ub) ///
		L`row' = (absref) M`row' = (absref_lb) N`row' = (absref_ub) ///
		O`row' = (abscomp) P`row' = (abscomp_lb) Q`row' = (abscomp_ub) /// 
		R`row' = (absdiff) S`row' = (absdiff_lb) T`row' = (absdiff_ub)
		
