label variable num_TN_comp "TN comp"
label variable num_TP_ref "TP ref"
label variable num_TP_comp "TP comp"

* Calculating primary and secondary outcomes - FPR and PPVs with 95% CIs
gen FPR_ref = num_FP_ref/(num_FP_ref+num_TN_ref)
label variable FPR_ref "False positive rate for reference group"
gen FPR_comp = num_FP_comp/(num_FP_comp+num_TN_comp)
label variable FPR_comp "False positive rate for comparison group"
gen RR_FPR_comp_ref = FPR_comp/FPR_ref
label variable RR_FPR_comp_ref "Relative risk of false positive rates in comparison group versus reference group"
gen PPV_ref = num_TP_ref/(num_TP_ref+num_FP_ref)
label variable PPV_ref "Positive predictive value for reference group"
gen PPV_comp = num_TP_comp/(num_TP_comp+num_FP_comp)
label variable PPV_comp "Positive predictive value for comparison group"
gen RR_PPV_comp_ref = PPV_comp/PPV_ref
label variable RR_PPV_comp_ref "Relative risk of positive predictive values in comparison group versus reference group" //be aware of missing values due to 0 observations in some cells

gen logseFPR = sqrt(1/num_FP_comp-1/(num_FP_comp+num_TN_comp)+1/num_FP_ref-1/(num_FP_ref+num_TN_ref))
label variable logseFPR "Standard Error for logRRFPR"
gen logsePPV = sqrt(1/num_TP_comp-1/(num_TP_comp+num_FP_comp)+1/num_TP_ref-1/(num_TP_ref+num_FP_ref))
label variable logsePPV "Standard Error for logRRPPV"
gen lower_ci = .
replace lower_ci = exp(log(RR_FPR_comp_ref) - 1.96 * logseFPR) if num_FP_ref != . & num_TN_ref != . & num_FP_comp != . & num_TN_comp !=.
replace lower_ci = exp(log(RR_PPV_comp_ref) - 1.96 * logsePPV) if num_TP_ref != . & num_FP_ref != . & num_TP_comp != . & num_FP_comp !=.
gen upper_ci = .
replace upper_ci = exp(log(RR_FPR_comp_ref) + 1.96 * logseFPR) if num_FP_ref != . & num_TN_ref != . & num_FP_comp != . & num_TN_comp !=.
replace upper_ci = exp(log(RR_PPV_comp_ref) + 1.96 * logsePPV) if num_TP_ref != . & num_FP_ref != . & num_TP_comp != . & num_FP_comp !=.

